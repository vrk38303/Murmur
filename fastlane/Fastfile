# Fastlane lanes for Murmur.
# Run from CI; you should never need to run these locally on a Mac.

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV['CI']  # creates a temp keychain, prevents UI prompts
  end

  desc "Fetch signing certificates and provisioning profiles via Match"
  lane :certificates do
    match(
      type: "appstore",
      readonly: true,        # CI never creates new certs; only reads
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )
  end

  desc "Build, sign, archive, and upload to TestFlight"
  lane :beta do
    # 1. Pull the App Store Connect API key from env (set in GitHub Secrets).
    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      duration:    1200,
      in_house:    false
    )

    # 2. Restore signing material into a fresh CI keychain.
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )

    # 3. Bump the build number from TestFlight's latest, so we never collide.
    #
    # We edit the Info.plist directly with PlistBuddy because XcodeGen bakes
    # the literal CFBundleVersion into the plist rather than emitting the
    # $(CURRENT_PROJECT_VERSION) Xcode variable that `increment_build_number`
    # targets. The `agvtool`-based path would silently no-op against our
    # generated project. PlistBuddy is unambiguous and matches what the
    # codemagic.yaml lane does.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.murmur.Murmur",
      initial_build_number: 0
    )
    next_build = latest + 1
    sh("/usr/libexec/PlistBuddy -c \"Set :CFBundleVersion #{next_build}\" ../Murmur/Resources/Info.plist")
    UI.message("Set CFBundleVersion to #{next_build} (was #{latest} on TestFlight)")

    # 4. Archive Release config.
    build_app(
      scheme: "Murmur",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Murmur.ipa",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      export_options: {
        provisioningProfiles: {
          "app.murmur.Murmur" => "match AppStore app.murmur.Murmur"
        }
      }
    )

    # 5. Ship to TestFlight. `skip_waiting_for_build_processing: true` returns
    #    immediately; Apple emails you when processing is done.
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/Murmur.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Internal build from #{ENV['GITHUB_SHA']&.[](0,7) || 'manual'}"
    )
  end

  desc "Generate the Xcode project from project.yml. Used by CI; safe locally."
  lane :generate do
    sh "cd .. && xcodegen generate"
  end

  desc "Capture App Store screenshots via the MurmurUITests UI test bundle"
  lane :screenshots do
    # Drives the MurmurSnapshots UI test on the iOS Simulator. Outputs land in
    # fastlane/screenshots/ and can be uploaded directly to App Store Connect
    # via `deliver` (not wired here for v1 — upload manually from the browser).
    capture_ios_screenshots
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
